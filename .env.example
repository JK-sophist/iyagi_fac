# ===== Core Service Ports =====
BACKEND_PORT=8000
FRONTEND_PORT=3000

# ===== Postgres =====
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=iyagi
POSTGRES_PASSWORD=iyagi
POSTGRES_DB=iyagi

# ===== Redis =====
REDIS_HOST=redis
REDIS_PORT=6379

# ===== LLM Runtime Guards =====
LLM_TIMEOUT_SECONDS=12
LLM_RETRY_COUNT=2
LLM_MAX_OUTPUT_TOKENS=700

# ===== OpenAI (Server-only) =====
OPENAI_API_KEY_SIMULATION=
OPENAI_API_KEY_EVALUATION=
OPENAI_PROJECT_ID_SIMULATION=
OPENAI_PROJECT_ID_EVALUATION=
OPENAI_MODEL_SCENE_CANDIDATE=gpt-4.1-mini
OPENAI_MODEL_SCENE_EXECUTION=gpt-4.1-mini

# ===== Environment-split Key Placeholders =====
OPENAI_API_KEY_DEV=
OPENAI_API_KEY_STAGING=
OPENAI_API_KEY_PROD_SIMULATION=
OPENAI_API_KEY_PROD_EVALUATION=
